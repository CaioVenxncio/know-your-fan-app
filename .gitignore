# --- Local data: never commit databases or generated datasets ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.data/
data/local/

# --- Secrets and environment ---
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.key

# --- Python caches and builds ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
build/
dist/
*.whl

# --- Virtual environments ---
.venv*/
venv/
env/
.python-version.local

# --- Test, coverage, and tool caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Generated outputs ---
outputs/
*.log

# --- OS and editor files ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# Test reports
junit-*.xml
coverage.xml

# --- Research outputs: commit archives and summaries, not working or derived files ---
experiments/results/*/observations.csv
experiments/results/*/observation_metrics.csv
experiments/results/*/trial_scores.csv.gz
experiments/results/*/summary.json
